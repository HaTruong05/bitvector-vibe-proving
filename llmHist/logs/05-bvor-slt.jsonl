rite (@bv_or_comm n (signed_min n) s).\n296\t        -- exact Hge.\n297\t        -- apply signed_min_size.\n298\t        -- exact Hs.\n299\t    + intro Hex. destruct Hex as [x [Hx_size Hle]].\n300\t      rewrite bv_sge_iff_sle. eapply bv_sle_trans.\n301\t      * apply bv_or_signed_min_lower_bound with (x := x).\n302\t        -- lia.\n303\t        -- exact Hs.\n304\t        -- exact Hx_size.\n305\t      * exact Hle.\n306\t  - rewrite Hn_zero in *.\n307\t    destruct s; [| unfold size in Hs; discriminate Hs].\n308\t    destruct t; [| unfold size in Ht; discriminate Ht]. \n309\t    split.\n310\t    + intro Hge. exists nil. split.\n311\t      * reflexivity.\n312\t      * compute. reflexivity.\n313\t    + intros [x [Hx_size Hle]].\n314\t      destruct x; [| unfold size in Hx_size; discriminate Hx_size].\n315\t      compute. reflexivity.\n316\tQed.\n317\t\n318\t\n319\t(* s >=s s & t <=> (exists x, x | s >=s t) *)\n320\tTheorem bvor_sge :\n321\t  forall (n : N), forall (s t : bitvector), (size s) = n -> (size t) = n ->\n322\t    iff\n323\t      ((bv_sge s (bv_and s t)) = true)\n324\t      (exists (x : bitvector), (size x = n) /\\\n325\t          ((bv_sge (bv_or x s) t) = true)).\n326\tProof.\n327\t  intros n s t H_size_s H_size_t.\n328\t  assert (H_cases : (0 < n \\/ n = 0)%N) by lia.\n329\t  destruct H_cases as [H_n_pos | H_n_zero].\n330\t  { \n331\t    split.\n332\t    - intro H_sge_and.\n333\t      exists (signed_max n); split.\n334\t      + apply signed_max_size.\n335\t      + apply bvor_smax_sge_helper; assumption.\n336\t    - intro H_exists; destruct H_exists as [x [H_size_x H_sge_or]].\n337\t      eapply bvor_sge_exists_helper; eassumption.\n338\t  }\n339\t  { \n340\t    rewrite H_n_zero in *.\n341\t    destruct s; [| unfold size in H_size_s; discriminate H_size_s].\n342\t    destruct t; [| unfold size in H_size_t; discriminate H_size_t].\n343\t    split.\n344\t    - intro H_sge_and. exists nil. split.\n345\t      + reflexivity.\n346\t      + compute. reflexivity.\n
_borrow b1 b2 b in\n  add_carry b1 (negb b2) (negb b) = (r, negb c).\nProof. destruct b1; destruct b2; destruct b; reflexivity. Qed.\n\n(* subst_list_borrow equals add_list_ingr with negated mask and negated carry-in *)\nLemma subst_list_borrow_eq_add_ingr : forall a b c,\n  length a = length b ->\n  subst_list_borrow a b c = add_list_ingr a (map negb b) (negb c).\nProof.\n  induction a as [| a1 as1 IH]; intros b c Hlen.","numLines":40,"startLine":15161,"totalLines":15615}},"sourceToolAssistantUUID":"ea180603-348f-4ce9-b2d8-0f6b73a10880","userType":"external","entrypoint":"claude-vscode","cwd":"/home/hakull245/bitvector-vibe-proving","sessionId":"2b65148c-b4a0-40d0-9fba-835c4508523c","version":"2.1.120","gitBranch":"haVibeProving"}

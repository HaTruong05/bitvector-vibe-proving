  destruct Huge as [Hugt | Heq].\n15282\t  - apply Z.lt_le_incl.\n15283\t    apply bv_ugt_bv_ult in Hugt.\n15284\t    apply ult_list_list2int.\n15285\t    + apply size_len_eq. now rewrite Hsize.\n15286\t    + unfold bv_ult in Hugt. rewrite Hsize, N.eqb_refl in Hugt. exact Hugt.\n15287\t  - subst. lia.\n15288\tQed.\n15289\t\n15290\t(* last v = true implies list2int v >= 2^(length v - 1) *)\n15291\tLemma last_true_list2int_lb : forall v,\n15292\t  v <> [] ->\n15293\t  last v false = true ->\n15294\t  (pow2_int (length v - 1) <= list2int v)%Z.\n15295\tProof.\n15296\t  intros v Hne Hlast.\n15297\t  pose proof (app_removelast_last false Hne) as Hdecomp.\n15298\t  pose proof (f_equal (@length bool) Hdecomp) as Hlen_eq.\n15299\t  rewrite length_app in Hlen_eq. simpl in Hlen_eq.\n15300\t  rewrite Hlast in Hdecomp.\n15301\t  rewrite Hdecomp.\n15302\t  rewrite list2int_app. simpl list2int. simpl bool2int. rewrite Z.mul_1_r.\n15303\t  rewrite length_app. simpl length. rewrite Nat.add_sub.\n15304\t  pose proof (@list2int_geq_zero (removelast v)) as Hge. lia.\n15305\tQed.\n15306\t\n15307\t(* If a non-neg (last=false) and b neg (last=true): list2int(a&b) <= list2int b - 2^(n-1) *)\n15308\tLemma last_false_and_true_submask_bound : forall a b,\n15309\t  length a = length b ->\n15310\t  last a false = false ->\n15311\t  last b false = true ->\n15312\t  (list2int (map2 andb a b) <= list2int b - pow2_int (length b - 1))%Z.\n15313\tProof.\n15314\t  intros a b Hlen Ha_last Hb_last.\n15315\t  assert (Hb_ne : b <> []).\n15316\t  { intro H. subst. simpl in Hb_last. discriminate. }\n15317\t  assert (Ha_ne : a <> []).\n15318\t  { intro H. subst. destruct b; [exact (Hb_ne eq_refl) | discriminate Hlen]. }\n15319\t  pose proof (app_removelast_last false Ha_ne) as Ha_decomp. rewrite Ha_last in Ha_decomp.\n15320\t  pose proof (app_removelast_last false Hb_ne) as Hb_decomp. rewrite Hb_last in Hb_decomp.\n15321\t  set (ia := removelast a). set (ib := removelast b).\n15322\t  assert (Hia_len : length ia = pred (length a)).\n15323\t  { unfold ia. apply (f_equal (@length bool)) in Ha_decomp.\n15324\t    rewrite length_app in Ha_decomp. simpl in Ha_decomp. lia. }\n15325\t  assert (Hib_len : length ib = pred (length b)).\n15326\t  { unfold ib. apply (f_equal (@length bool)) in Hb_decomp.\n15327\t    rewrite length_app in Hb_decomp. simpl in Hb_decomp. lia. }\n15328\t  assert (Hlen_iab : length ia = length ib) by lia.\n15329\t  assert (Hle_and_ib : (list2int (map2 andb ia ib) <= list2int ib)%Z).\n15330\t  { apply ule_list_list2int.\n15331\t    - pose proof (map2_and_length Hlen_iab) as Hmap2_len. lia.\n15332\t    - rewrite map2_and_comm. apply ule_list_map2_and. lia. }\n15333\t  assert (Hb_int : (list2int b = list2int ib + pow2_int (length ib))%Z).\n15334\t  { rewrite Hb_decomp, list2int_app, list2int_bool.\n15335\t    change (bool2int true) with 1%Z. rewrite Z.mul_1_r. apply Z.add_comm. }\n15336\t  assert (Handb_int : (list2int (map2 andb a b) = list2int (map2 andb ia ib))%Z).\n15337\t  { rewrite Ha_decomp, Hb_decomp.\n15338\t    rewrite map2_and_app; [| exact Hlen_iab | easy].\n15339\t    simpl (map2 andb [false] [true]).\n15340\t    rewrite list2int_app, list2int_bool.\n15341\t    change (bool2int false) with 0%Z. rewrite Z.mul_0_r. rewrite Z.add_0_l. reflexivity. }\n15342\t  assert (Hpow : pow2_int (length b - 1) = pow2_int (length ib)).\n15343\t  { f_equal. lia. }\n15344\t  lia.\n15345\tQed.\n15346\t\n15347\t(* Key lemma for bvand_sge backward direction *)\n15348\tLemma bvand_sge_key : forall (n : N) (s t x : bitvector),\n15349\t  size s = n -> size t = n -> size x = n ->\n15350\t  bv_slt t (bv_and x s) = true ->\n15351\t  bv_and s t = t \\/ bv_slt t (bv_and (bv_subt t s) s) = true.\n15352\tProof.\n15353\t  intros n s t x Hs Ht Hx Hslt.\n15354\t  pose proof (@bv_and_size n x s Hx Hs) as Hxs_sz.\n15355\t  pose proof (@bv_subt_size n t s Ht Hs) as HD_sz.\n15356\t  pose proof (@bv_and_size n (bv_subt t s) s HD_sz Hs) as HDs_sz.\n15357\t  pose proof (@size_to_length n s Hs) as Hlen_s.\n15358\t  pose proof (@size_to_length n t Ht) as Hlen_t.\n15359\t  pose proof (@size_to_length n x Hx) as Hlen_x."}]},"uuid":"8a487428-070e-4ffb-9e4f-3024b12a9c2b","timestamp":"2026-04-25T21:20:44.491Z","toolUseResult":{"type":"text","file":{"filePath":"/home/hakull245/bitvector-vibe-proving/BVList.v","content":"Lemma list2int_map2_and_or_sum : forall a b,\n  length a = length b ->\n  (list2int (map2 andb a b) + list2int (map2 orb a b) = list2int a + list2int b)%Z.\nProof.\n  induction a as [| a1 as1 IH]; intros b Hlen.\n  - destruct b; [simpl; lia | discriminate Hlen].\n  - destruct b as [| b1 bs]; [discriminate Hlen |].\n    simpl in Hlen. injection Hlen as Hlen.\n    simpl (map2 andb (a1 :: as1) (b1 :: bs)).\n    simpl (map2 orb (a1 :: as1) (b1 :: bs)).\n    rewrite !list2int_cons.\n    pose proof (IH bs Hlen) as IH'.\n    destruct a1; destruct b1; simpl bool2int; lia.\nQed.\n\n(* ule_list implies list2int ≤ *)\nLemma ule_list_list2int : forall x y,\n  length x = length y ->\n  ule_list x y = true ->\n  (list2int x <= list2int y)%Z.\nProof.\n  intros x y Hlen H.\n  unfold ule_list in H.\n  apply ule_list_big_endian_implies_ult_list_big_endian_or_eq in H.\n  destruct H as [H | H].\n  - apply Z.lt_le_incl.\n    assert (Hlenr : length (rev x) = length (rev y)) by (now rewrite !length_rev).\n    apply ult_list_big_endian_list2int in H; [| exact Hlenr].\n    now rewrite !rev_involutive in H.\n  - apply rev_inj in H. subst. lia.\nQed.\n\n(* bv_ult a b = false implies list2int b ≤ list2int a *)\nLemma bv_ult_false_list2int_ge : forall a b,\n  size a = size b ->\n  bv_ult a b = false ->\n  (list2int b <= list2int a)%Z.\nProof.\n  intros a b Hsize Hult.\n  pose proof (not_bv_ult_implies_bv_uge Hsize Hult) as Huge.\n  apply bv_uge_eq in Huge.\n  destruct Huge as [Hugt | Heq].\n  - apply Z.lt_le_incl.\n    apply bv_ugt_bv_ult in Hugt.\n    apply ult_list_list2int.\n    + apply size_len_eq. now rewrite Hsize.\n    + unfold bv_ult in Hugt. rewrite Hsize, N.eqb_refl in Hugt. exact Hugt.\n  - subst. lia.\nQed.\n\n(* last v = true implies list2int v >= 2^(length v - 1) *)\nLemma last_true_list2int_lb : forall v,\n  v <> [] ->\n  last v false = true ->\n  (pow2_int (length v - 1) <= list2int v)%Z.\nProof.\n  intros v Hne Hlast.\n  pose proof (app_removelast_last false Hne) as Hdecomp.\n  pose proof (f_equal (@length bool) Hdecomp) as Hlen_eq.\n  rewrite length_app in Hlen_eq. simpl in Hlen_eq.\n  rewrite Hlast in Hdecomp.\n  rewrite Hdecomp.\n  rewrite list2int_app. simpl list2int. simpl bool2int. rewrite Z.mul_1_r.\n  rewrite length_app. simpl length. rewrite Nat.add_sub.\n  pose proof (@list2int_geq_zero (removelast v)) as Hge. lia.\nQed.\n\n(* If a non-neg (last=false) and b neg (last=true): list2int(a&b) <= list2int b - 2^(n-1) *)\nLemma last_false_and_true_submask_bound : forall a b,\n  length a = length b ->\n  last a false = false ->\n  last b false = true ->\n  (list2int (map2 andb a b) <= list2int b - pow2_int (length b - 1))%Z.\nProof.\n  intros a b Hlen Ha_last Hb_last.\n  assert (Hb_ne : b <> []).\n  { intro H. subst. simpl in Hb_last. discriminate. }\n  assert (Ha_ne : a <> []).\n  { intro H. subst. destruct b; [exact (Hb_ne eq_refl) | discriminate Hlen]. }\n  pose proof (app_removelast_last false Ha_ne) as Ha_decomp. rewrite Ha_last in Ha_decomp.\n  pose proof (app_removelast_last false Hb_ne) as Hb_decomp. rewrite Hb_last in Hb_decomp.\n  set (ia := removelast a). set (ib := removelast b).\n  assert (Hia_len : length ia = pred (length a)).\n  { unfold ia. apply (f_equal (@length bool)) in Ha_decomp.\n    rewrite length_app in Ha_decomp. simpl in Ha_decomp. lia. }\n  assert (Hib_len : length ib = pred (length b)).\n  { unfold ib. apply (f_equal (@length bool)) in Hb_decomp.\n    rewrite length_app in Hb_decomp. simpl in Hb_decomp. lia. }\n  assert (Hlen_iab : length ia = length ib) by lia.\n  assert (Hle_and_ib : (list2int (map2 andb ia ib) <= list2int ib)%Z).\n  { apply ule_list_list2int.\n    - pose proof (map2_and_length Hlen_iab) as Hmap2_len. lia.\n    - rewrite map2_and_comm. apply ule_list_map2_and. lia. }\n  assert (Hb_int : (list2int b = list2int ib + pow2_int (length ib))%Z).\n  { rewrite Hb_decomp, list2int_app, list2int_bool.\n    change (bool2int true) with 1%Z. rewrite Z.mul_1_r. apply Z.add_comm. }\n  assert (Handb_int : (list2int (map2 andb a b) = list2int (map2 andb ia ib))%Z).\n  { rewrite Ha_decomp, Hb_decomp.\n    rewrite map2_and_app; [| exact Hlen_iab | easy].\n    simpl (map2 andb [false] [true]).\n    rewrite list2int_app, list2int_bool.\n    change (bool2int false) with 0%Z. rewrite Z.mul_0_r. rewrite Z.add_0_l. reflexivity. }\n  assert (Hpow : pow2_int (length b - 1) = pow2_int (length ib)).\n  { f_equal. lia. }\n  lia.\nQed.\n\n(* Key lemma for bvand_sge backward direction *)\nLemma bvand_sge_key : forall (n : N) (s t x : bitvector),\n  size s = n -> size t = n -> size x = n ->\n  bv_slt t (bv_and x s) = true ->\n  bv_and s t = t \\/ bv_slt t (bv_and (bv_subt t s) s) = true.\nProof.\n  intros n s t x Hs Ht Hx Hslt.\n  pose proof (@bv_and_size n x s Hx Hs) as Hxs_sz.\n  pose proof (@bv_subt_size n t s Ht Hs) as HD_sz.\n  pose proof (@bv_and_size n (bv_subt t s) s HD_sz Hs) as HDs_sz.\n  pose proof (@size_to_length n s Hs) as Hlen_s.\n  pose proof (@size_to_length n t Ht) as Hlen_t.\n  pose proof (@size_to_length n x Hx) as Hlen_x.","numLines":120,"startLine":15240,"totalLines":15615}},"sourceToolAssistantUUID":"695eeef7-d5f8-4b7d-b6c0-282b76393edc","userType":"external","entrypoint":"claude-vscode","cwd":"/home/hakull245/bitvector-vibe-proving","sessionId":"2b65148c-b4a0-40d0-9fba-835c4508523c","version":"2.1.120","gitBranch":"haVibeProving"}
